# === VMG MKT OS - biến môi trường ===
# Sao chép file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# PostgreSQL. Dev có thể trỏ sang Supabase; production tự lưu trữ hoặc Supabase (SPEC Mục 13.2).
# Supabase: lấy ở Project Settings > Database > Connection string > "Transaction pooler".
DATABASE_URL="postgresql://user:password@localhost:5432/vmg_mkt_os"

# Auth.js (NextAuth v5). Sinh chuỗi ngẫu nhiên: `npx auth secret` hoặc `openssl rand -base64 32`
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"

# URL gốc của ứng dụng (dùng cho liên kết thông báo, magic link). Không dấu / ở cuối.
APP_URL="http://localhost:3000"

# Múi giờ vận hành - cố định, không đổi (SPEC Mục 2.6).
APP_TZ="Asia/Ho_Chi_Minh"

# Bật/tắt cron trong tiến trình (self-host). Trên Vercel dùng vercel.json crons thay vì biến này.
ENABLE_CRON="true"

# Bảo vệ GET /api/cron (Vercel Cron gửi Authorization: Bearer $CRON_SECRET).
CRON_SECRET=""

# SMTP cho email thông báo (Mục 11.1). Để trống thì chỉ ghi log, không gửi thật.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VMG MKT OS <no-reply@vmg.local>"

# Docker Compose (docker-compose.yml)
POSTGRES_USER="vmg"
POSTGRES_PASSWORD=""
POSTGRES_DB="vmg_mkt_os"
APP_DOMAIN="mkt.vmg.local"

# Seed ban đầu (Mục 15) — [CẦN XÁC NHẬN] email thật trước khi seed lên production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
