# === VMG TMĐT OS - biến môi trường ===
# Sao chép file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# PostgreSQL. Dev có thể trỏ sang Supabase; production trỏ sang Postgres self-host (spec Mục 5.3).
# Supabase: lấy ở Project Settings > Database > Connection string > "Transaction pooler" hoặc "Session".
# Ví dụ: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/vmg_tmdt_os"

# Auth.js (NextAuth v5). Sinh chuỗi ngẫu nhiên: `npx auth secret` hoặc `openssl rand -base64 32`
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"

# URL gốc của ứng dụng (dùng cho callback, email cảnh báo). Không dấu / ở cuối.
APP_URL="http://localhost:3000"

# Múi giờ vận hành - cố định, không đổi (spec Mục 5.2).
APP_TZ="Asia/Ho_Chi_Minh"

# Bật/tắt cron trong tiến trình (cảnh báo 8h sáng...). Đặt "false" khi chạy nhiều instance.
ENABLE_CRON="true"

# SMTP cho cảnh báo email (Phase 2 - có thể để trống ở Phase 0/1)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VMG TMĐT OS <no-reply@vmg.local>"
